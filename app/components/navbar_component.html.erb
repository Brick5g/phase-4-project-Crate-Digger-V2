<nav class="navbar">
  <%= link_to "Crate Digger",
              root_path,
              class: "navbar-brand" %>

  <div class="navbar-links">
    <%= link_to "Releases",
                records_path %>

    <%= link_to "Artists",
                artists_path %>

    <%= link_to "Genres",
                genres_path %>

    <% if logged_in? %>
      <%= link_to "Find Music",
                  music_search_path %>

      <%= link_to "My Collection",
                  collection_entries_path %>

      <%= button_to "Log Out",
                    logout_path,
                    method: :delete %>
    <% else %>
      <%= link_to "Sign Up",
                  signup_path %>

      <%= link_to "Log In",
                  login_path %>
    <% end %>
  </div>
</nav>
