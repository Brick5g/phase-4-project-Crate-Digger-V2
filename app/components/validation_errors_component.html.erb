<% if errors? %>
  <div class="validation-errors">
    <h2>
      <%= pluralize(
            @resource.errors.count,
            "error"
          ) %>
      prevented this from being saved:
    </h2>

    <ul>
      <% @resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
