<h1><%= @genre.name %></h1>

<% if @genre.description.present? %>
  <p>
    <%= @genre.description %>
  </p>
<% end %>

<h2>Releases in This Genre</h2>

<p>
  These releases have been associated with
  <strong><%= @genre.name %></strong>.
</p>

<% if @genre.records.any? %>
  <% @genre.records.alphabetical.each do |record| %>
    <div>
      <% if record.artwork_url.present? %>
        <%= image_tag record.artwork_url,
                      alt: "#{record.title} cover" %>
      <% end %>

      <h3>
        <%= link_to record.title,
                    record_path(record) %>
      </h3>

      <p>
        Artist:
        <%= record.artist.name %>
      </p>

      <p>
        Release Type:
        <%= record.release_type %>
      </p>

      <p>
        Release Date:
        <%= record.release_date || "Unknown" %>
      </p>
    </div>
  <% end %>
<% else %>
  <p>
    No releases currently use this genre.
  </p>
<% end %>

<% if current_user %>
  <p>
    <%= link_to "Edit Genre",
                edit_genre_path(@genre) %>
  </p>
<% end %>

<p>
  <%= link_to "Back to Genres", genres_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
