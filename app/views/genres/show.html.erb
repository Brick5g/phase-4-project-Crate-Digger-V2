<h1><%= @genre.name %></h1>

<p>
  <%= @genre.description %>
</p>

<h2>Records in <%= @genre.name %></h2>

<% if @genre.records.any? %>
  <% @genre.records.each do |record| %>
    <div>
      <h3>
        <%= link_to record.title, record_path(record) %>
      </h3>

      <p>
        Artist:
        <%= record.artist.name %>
      </p>

      <p>
        Release Year:
        <%= record.release_year %>
      </p>

      <p>
        Format:
        <%= record.format %>
      </p>
    </div>
  <% end %>
<% else %>
  <p>
    No records are currently associated with this genre.
  </p>

  <p>
    Genres can be attached from an individual record's page.
  </p>

  <p>
    <%= link_to "Browse Records", records_path %>
  </p>
<% end %>

<p>
  <%= link_to "Edit Genre", edit_genre_path(@genre) %>
</p>

<p>
  <%= link_to "Back to Genres", genres_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>

<%= button_to "Delete Genre",
              genre_path(@genre),
              method: :delete,
              data: {
                turbo_confirm: "Are you sure you want to delete this genre?"
              } %>
