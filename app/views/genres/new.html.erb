<h1>Add a New Genre</h1>

<p>
  Create a genre that can be attached to records.
  Use the description to briefly explain the musical style.
</p>

<%= render ValidationErrorsComponent.new(
      resource: @genre
    ) %>

<%= form_with model: @genre do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <%= form.submit "Create Genre" %>
<% end %>

<p>
  <%= link_to "Back to Genres", genres_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
