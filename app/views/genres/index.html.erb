<h1>Genres</h1>

<p>
  Browse the music genres currently used in Crate Digger.
</p>

<p>
  Select a genre to see the releases connected to it.
</p>

<p>
  <%= link_to "Home",
              root_path %>
</p>

<% @genres.each do |genre| %>
  <div>
    <h2>
      <%= link_to genre.name,
                  genre_path(genre) %>
    </h2>
  </div>
<% end %>
