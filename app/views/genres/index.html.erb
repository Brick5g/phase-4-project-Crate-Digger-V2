<h1>Genres</h1>

<p>
  Browse the music genres currently used in Crate Digger.
</p>

<p>
  Genres are normally added while adding a release
  or editing an artist.
</p>

<p><%= link_to "Home", root_path %></p>

<% @genres.each do |genre| %>
  <h2>
    <%= link_to genre.name, genre_path(genre) %>
  </h2>

  <% if genre.description.present? %>
    <p><%= genre.description %></p>
  <% end %>
<% end %>
