<h1>
  <%= @artist_name || "Artist Releases" %>
</h1>

<% if @artist_country.present? %>
  <p>
    Country:
    <strong><%= @artist_country %></strong>
  </p>
<% end %>

<p>
  These releases come from MusicBrainz.
</p>

<p>
  Crate Digger loads the artist's release groups
  instead of stopping after the first search page.
</p>

<% if @error %>
  <div class="search-message">
    <h2>Loading Problem</h2>

    <p>
      <%= @error %>
    </p>
  </div>
<% end %>

<% if @release_results.any? %>
  <h2>
    Releases (<%= @release_results.length %>)
  </h2>

  <div class="release-results-grid">
    <% @release_results.each do |release| %>
      <%= render MusicSearch::ReleaseResultComponent.new(
        release: release
      ) %>
    <% end %>
  </div>

  <% elsif !@error %>
  <div class="search-message">
    <h2>No Releases Found</h2>

    <p>
      No releases were found for this artist.
    </p>
  </div>
<% end %>

<div class="page-actions">
  <%= link_to "Back to Music Search",
              music_search_path,
              class: "search-link" %>

  <%= link_to "Home",
              root_path,
              class: "search-link" %>
</div>
