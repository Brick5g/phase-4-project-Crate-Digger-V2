<h1>Find Music</h1>

<p>
  Search by artist, album, EP, single, mixtape,
  or another music release.
</p>

<p>
  You can search for an artist such as
  <strong>Larry June</strong>,
  or a specific release such as
  <strong>Midnight Marauders A Tribe Called Quest</strong>.
</p>

<%= form_with url: music_search_path, method: :get do |form| %>
  <div>
    <%= form.label :query, "What music are you looking for?" %>

    <%= form.text_field(
          :query,
          value: @query,
          placeholder: "Artist or release name"
        ) %>
  </div>

  <%= form.submit "Search Music" %>
<% end %>

<% if @error %>
  <h2>Search Problem</h2>

  <p><%= @error %></p>
<% end %>

<% if @artist_results.any? %>
  <h2>Artist Matches</h2>

  <p>
    Looking for an artist's full discography?
    Choose the artist below.
  </p>

  <% @artist_results.each do |artist| %>
    <div>
      <h3><%= artist["name"] %></h3>

      <% if artist["disambiguation"].present? %>
        <p><%= artist["disambiguation"] %></p>
      <% end %>

      <% if artist["country"].present? %>
        <p>
          Country:
          <%= artist["country"] %>
        </p>
      <% end %>

      <p>
        MusicBrainz Match Score:
        <%= artist["score"] %>
      </p>

      <p>
        <%= link_to(
              "View All Releases",
              music_search_artist_path(
                artist["id"]
              )
            ) %>
      </p>
    </div>
  <% end %>
<% end %>

<% if @release_results.any? %>
  <h2>Release Matches</h2>

  <p>
    If you already see the release you want,
    you can save it immediately.
  </p>

  <% @release_results.each do |release| %>
    <% artist_names =
         release.fetch(
           "artist-credit",
           []
         ).map do |credit|
           credit["name"]
         end.compact.join(", ") %>

    <div>
      <%= image_tag(
            "https://coverartarchive.org/release-group/#{release["id"]}/front-250",
            alt: "#{release["title"]} cover",
            width: 150,
            onerror: "this.style.display='none'"
          ) %>

      <h3><%= release["title"] %></h3>

      <p>
        Artist:
        <%= artist_names.presence || "Unknown Artist" %>
      </p>

      <p>
        Release Type:
        <%= release["primary-type"].presence || "Unknown" %>
      </p>

      <p>
        First Released:
        <%= release["first-release-date"].presence || "Unknown" %>
      </p>

      <p>
        <%= button_to(
              "Add to My Collection",
              import_music_release_path(
                release["id"]
              ),
              method: :post
            ) %>
      </p>
    </div>
  <% end %>
<% end %>

<% if @query.present? &&
      @artist_results.empty? &&
      @release_results.empty? &&
      !@error %>

  <h2>No Results Found</h2>

  <p>
    We could not find anything matching
    <strong><%= @query %></strong>.
  </p>
<% end %>

<p>
  <%= link_to "Enter a Release Manually", new_record_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
