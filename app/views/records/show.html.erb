<div class="record-show">
  <section class="record-hero">
    <div class="record-artwork-section">
      <% if @record.artwork_url.present? %>
        <%= image_tag @record.artwork_url,
                      alt: "#{@record.title} cover",
                      class: "record-show-cover" %>
      <% else %>
        <div class="record-show-cover-missing">
          No Artwork
        </div>
      <% end %>
    </div>

    <div class="record-details">
      <p class="record-show-label">
        <%= @record.release_type %>
      </p>

      <h1>
        <%= @record.title %>
      </h1>

      <h2 class="record-show-artist">
        <%= link_to @record.artist.name,
                    artist_path(@record.artist) %>
      </h2>

      <div class="record-metadata">
        <p>
          <strong>Release Type:</strong>
          <%= @record.release_type %>
        </p>

        <p>
          <strong>Release Date:</strong>
          <%= @record.release_date || "Unknown" %>
        </p>
      </div>

      <% if @record.description.present? %>
        <div class="record-description">
          <h3>About This Release</h3>

          <p>
            <%= @record.description %>
          </p>
        </div>
      <% end %>

      <div class="record-genres">
        <h3>Genres</h3>

        <% if @record.record_genres.any? %>
          <div class="genre-tags">
            <% @record.record_genres.each do |record_genre| %>
             <%= render GenreTagComponent.new(
                record_genre: record_genre
              ) %>
            <% end %>
          </div>
        <% else %>
          <p>
            No genres have been added to this release yet.
          </p>
        <% end %>

        <% if current_user %>
          <%= link_to "Choose Release Genres",
                      new_record_record_genre_path(@record),
                      class: "record-action-link" %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="record-section">
    <h2>My Crate</h2>

    <%= render CrateStatusComponent.new(
      record: @record,
      current_user: current_user
    ) %>
  </section>

  <section class="record-section">
    <h2>Reviews</h2>

    <% if @record.reviews.any? %>
      <div class="record-reviews">
        <% @record.reviews.each do |review| %>
          <%= render ReviewCardComponent.new(
            review: review,
            current_user: current_user
          ) %>
        <% end %>
      </div>
    <% else %>
      <p>
        Nobody has reviewed this release yet.
      </p>
    <% end %>

    <% if current_user %>
      <% my_review =
           current_user.review_for(@record) %>

      <% unless my_review %>
        <%= link_to "Review This Release",
                    new_record_review_path(@record),
                    class: "record-action-link" %>
      <% end %>
    <% else %>
      <p>
        Log in to leave a review.
      </p>
    <% end %>
  </section>

  <section class="record-section record-management">
    <h2>Release Management</h2>

    <p>
      Logged-in users can help keep the shared music information accurate.
    </p>

    <% if current_user %>
      <div class="record-management-actions">
        <%= link_to "Edit Release",
                    edit_record_path(@record),
                    class: "record-action-link" %>

        <%= button_to "Delete Release",
                      record_path(@record),
                      method: :delete,
                      class: "record-delete-button",
                      data: {
                        turbo_confirm: "Delete this release?"
                      } %>
      </div>
    <% end %>
  </section>

  <div class="page-actions">
    <%= link_to "Back to Releases",
                records_path,
                class: "search-link" %>

    <%= link_to "Home",
                root_path,
                class: "search-link" %>
  </div>
</div>
