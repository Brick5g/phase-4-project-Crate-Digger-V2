<h1>Releases</h1>

<p>
  Browse the music currently available in Crate Digger.
  Select a release to see more information, read reviews,
  save it to your collection, or leave your own review.
</p>

<p>
  <%= link_to "Add New Release", new_record_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>

<% if @records.any? %>
  <% @records.each do |record| %>
    <div>
      <% if record.artwork_url.present? %>
        <%= image_tag record.artwork_url,
                      alt: "#{record.title} cover" %>
      <% end %>

      <h2>
        <%= link_to record.title, record_path(record) %>
      </h2>

      <p>
        Artist:
        <%= record.artist.name %>
      </p>

      <p>
        Release Type:
        <%= record.release_type %>
      </p>

      <p>
        Release Date:
        <%= record.release_date || "Unknown" %>
      </p>
    </div>
  <% end %>
<% else %>
  <h2>No releases have been added yet.</h2>

  <p>
    Be the first person to add music to Crate Digger.
  </p>
<% end %>
