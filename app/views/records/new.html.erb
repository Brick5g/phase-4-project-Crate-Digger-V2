<h1>Add a Release</h1>

<p>
  Add a music release to Crate Digger.
</p>

<p>
  A release can be an album, EP, single, mixtape, or another published
  music project.
</p>

<p>
  Don't worry if you do not know every detail.
  Some information can be filled in automatically when music search is added.
</p>

<% if @record.errors.any? %>
  <div>
    <h2>Please fix the following:</h2>

    <ul>
      <% @record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @record do |form| %>
  <div>
    <%= form.label :title, "Release Title" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :artist_id, "Artist" %>
    <%= form.collection_select :artist_id, @artists, :id, :name %>
  </div>

  <div>
    <%= form.label :release_date, "Release Date" %>
    <%= form.date_field :release_date %>
  </div>

  <div>
    <%= form.label :release_type, "Release Type" %>

    <%= form.select :release_type,
                    [ "Album", "EP", "Single", "Mixtape", "Other" ] %>
  </div>

  <div>
    <%= form.label :description, "Description (Optional)" %>
    <%= form.text_area :description %>
  </div>

  <%= form.submit "Add Release" %>
<% end %>

<p>
  Can't find the artist?
  <%= link_to "Add the Artist First", new_artist_path %>
</p>

<p>
  <%= link_to "Back to Releases", records_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
