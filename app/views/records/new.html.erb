<h1>Add a New Record</h1>

<p>
  Add a record to the Crate Digger database.
  Choose an existing artist and enter the record's basic release information.
</p>

<p>
  If the artist is not listed yet, add the artist first before creating the record.
</p>

<% if @record.errors.any? %>
  <div>
    <h2>Please fix the following:</h2>

    <ul>
      <% @record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @record do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :release_year %>
    <%= form.number_field :release_year %>
  </div>

  <div>
    <%= form.label :format %>
    <%= form.text_field :format %>
  </div>

  <div>
    <%= form.label :condition %>
    <%= form.text_field :condition %>
  </div>

  <div>
    <%= form.label :artist_id, "Artist" %>
    <%= form.collection_select :artist_id, @artists, :id, :name %>
  </div>

  <%= form.submit "Create Record" %>
<% end %>

<p>
  <%= link_to "Add New Artist", new_artist_path %>
</p>

<p>
  <%= link_to "Back to Records", records_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
