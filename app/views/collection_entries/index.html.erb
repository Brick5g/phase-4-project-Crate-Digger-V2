<h1>My Collection</h1>

<p>
  This is your personal vinyl collection.
  Records you add from the Crate Digger database will appear here.
</p>

<p>
  To add another record, browse the record database and select
  "Add to Collection" from the record's page.
</p>

<p>
  <%= link_to "Browse Records", records_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>

<% if @collection_entries.any? %>
  <% @collection_entries.each do |entry| %>
    <div>
      <h2>
        <%= entry.record.title %>
      </h2>

      <p>
        Artist:
        <%= entry.record.artist.name %>
      </p>

      <p>
        Purchase Price:
        $<%= entry.purchase_price %>
      </p>

      <p>
        Notes:
        <%= entry.notes %>
      </p>

      <p>
        <%= link_to "View Record", record_path(entry.record) %>
      </p>

      <p>
        <%= link_to "Edit Collection Entry",
                    edit_collection_entry_path(entry) %>
      </p>

      <%= button_to "Remove from Collection",
                    collection_entry_path(entry),
                    method: :delete,
                    data: {
                      turbo_confirm: "Remove this record from your collection?"
                    } %>
    </div>
  <% end %>
<% else %>
  <h2>Your crate is empty!</h2>

  <p>
    Browse the record database and add something to start your collection.
  </p>

  <p>
    <%= link_to "Find Some Records", records_path %>
  </p>
<% end %>
