<h1>My Collection</h1>

<p>
  These are the releases you have saved to your personal Crate Digger collection.
</p>

<p>
  Want to save something else?
  Browse the releases and choose "Save to My Collection."
</p>

<p>
  <%= link_to "Browse Releases", records_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>

<% if @collection_entries.any? %>
  <div class="collection-grid">
    <% @collection_entries.each do |entry| %>
      <div class="collection-card">
        <% if entry.record.artwork_url.present? %>
          <%= image_tag entry.record.artwork_url,
                        alt: "#{entry.record.title} cover",
                        class: "collection-cover" %>
        <% else %>
          <div class="collection-cover-missing">
            No Artwork
          </div>
        <% end %>

        <div class="collection-info">
          <h2>
            <%= entry.record.title %>
          </h2>

          <p class="collection-artist">
            <%= entry.record.artist.name %>
          </p>

          <% review = current_user.reviews.find_by(record: entry.record) %>

          <% if review %>
            <p class="collection-rating">
              My Rating:
              <strong><%= review.rating %> / 10</strong>
            </p>
          <% else %>
            <p>
              You have not rated this release yet.
            </p>

            <p>
              <%= link_to "Rate This Release",
                          new_record_review_path(entry.record) %>
            </p>
          <% end %>

          <% if entry.notes.present? %>
            <div class="collection-note">
              <strong>My Note:</strong>

              <p>
                <%= entry.notes %>
              </p>
            </div>
          <% end %>

          <div class="collection-actions">
            <%= link_to "View Release",
                        record_path(entry.record),
                        class: "collection-link" %>

            <%= link_to "Edit My Note",
                        edit_collection_entry_path(entry),
                        class: "collection-link" %>

            <%= button_to "Remove",
                          collection_entry_path(entry),
                          method: :delete,
                          class: "collection-remove-button",
                          data: {
                            turbo_confirm: "Remove this release from your collection?"
                          } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <h2>Your Collection Is Empty</h2>

  <p>
    You have not saved any releases yet.
  </p>

  <p>
    Start by browsing releases or searching for music.
  </p>

  <p>
    <%= link_to "Browse Releases", records_path %>
  </p>

  <p>
    <%= link_to "Search for Music", music_search_path %>
  </p>
<% end %>
