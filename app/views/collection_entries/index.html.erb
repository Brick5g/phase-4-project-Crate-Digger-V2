<h1>My Collection</h1>

<p>
  These are the releases you have saved to your personal Crate Digger collection.
</p>

<p>
  Want to save something else?
  Browse the releases and choose "Save to My Collection."
</p>

<p>
  <%= link_to "Browse Releases", records_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>

<% if @collection_entries.any? %>
  <div class="collection-grid">
    <% @collection_entries.each do |entry| %>
      <%= render CollectionCardComponent.new(
            entry: entry,
            review: current_user.review_from(entry.record)
          ) %>
    <% end %>
  </div>
<% else %>
  <h2>Your Collection Is Empty</h2>

  <p>
    You have not saved any releases yet.
  </p>

  <p>
    Start by browsing releases or searching for music.
  </p>

  <p>
    <%= link_to "Browse Releases", records_path %>
  </p>

  <p>
    <%= link_to "Search for Music", music_search_path %>
  </p>
<% end %>
