<h1>Edit My Saved Release</h1>

<p>
  You are editing your private note for
  <strong><%= @collection_entry.record.title %></strong>.
</p>

<p>
  This does not change the release itself or anyone else's information.
</p>

<% if @collection_entry.errors.any? %>
  <div>
    <h2>Please fix the following:</h2>

    <ul>
      <% @collection_entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @collection_entry do |form| %>
  <div>
    <%= form.label :notes, "Personal Note" %>
    <%= form.text_area :notes %>
  </div>

  <%= form.submit "Save My Note" %>
<% end %>

<p>
  <%= link_to "Back to My Collection", collection_entries_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
