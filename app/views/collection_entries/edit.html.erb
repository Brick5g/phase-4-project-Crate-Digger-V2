<h1>Edit Collection Entry</h1>

<% if @collection_entry.errors.any? %>
  <div>
    <h2>There were some problems:</h2>

    <ul>
      <% @collection_entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @collection_entry do |form| %>
  <div>
    <%= form.label :purchase_price %>
    <%= form.number_field :purchase_price, step: 0.01 %>
  </div>

  <div>
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <%= form.submit "Update Collection Entry" %>
<% end %>
