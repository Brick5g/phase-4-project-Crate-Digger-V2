<h1>Add <%= @record.title %> to My Collection</h1>

<p>
  Save this record to your personal collection.
  You can include what you paid for it and any notes you want to remember.
</p>

<% if @collection_entry.errors.any? %>
  <div>
    <h2>Please fix the following:</h2>

    <ul>
      <% @collection_entry.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [ @record, @collection_entry ] do |form| %>
  <div>
    <%= form.label :purchase_price, "Purchase Price" %>
    <%= form.number_field :purchase_price, step: 0.01 %>
  </div>

  <div>
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <%= form.submit "Add to My Collection" %>
<% end %>

<p>
  <%= link_to "Back to Record", record_path(@record) %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
