<h1>Save <%= @record.title %> to My Collection</h1>

<p>
  Saving a release puts it in your personal Crate Digger collection
  so you can easily find it again later.
</p>

<p>
  You can also leave a private note for yourself.
</p>

<%= render ValidationErrorsComponent.new(
      resource: @collection_entry
    ) %>

<%= form_with model: [ @record, @collection_entry ] do |form| %>
  <div>
    <%= form.label :notes, "Personal Note" %>
    <%= form.text_area :notes %>
  </div>

  <%= form.submit "Save to My Collection" %>
<% end %>

<p>
  <%= link_to "Back to Release", record_path(@record) %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
