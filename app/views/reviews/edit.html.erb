<h1>Edit My Review</h1>

<p>
  Update your rating or thoughts about
  <strong><%= @review.record.title %></strong>.
</p>

<p>
  Your score must be between 1 and 10.
  Written thoughts are optional.
</p>

<% if @review.errors.any? %>
  <div class="review-errors">
    <h2>Please fix the following:</h2>

    <ul>
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @review do |form| %>
  <div class="review-form-section">
    <h2>Your Rating</h2>

    <div class="rating-labels">
      <span>Did not enjoy it</span>
      <span>Loved it</span>
    </div>

    <div class="rating-options">
      <% (1..10).each do |number| %>
        <div class="rating-choice">
          <%= form.radio_button :rating, number %>
          <%= form.label :rating,
                         number,
                         value: number,
                         class: "rating-button" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="review-form-section">
    <%= form.label :body, "Your Thoughts (Optional)" %>

    <%= form.text_area :body,
                       placeholder: "What stood out to you about this release?" %>
  </div>

  <%= form.submit "Update My Review" %>
<% end %>

<p>
  <%= link_to "Back to Release", record_path(@review.record) %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
