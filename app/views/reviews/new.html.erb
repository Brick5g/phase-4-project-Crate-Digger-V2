<h1>Review <%= @record.title %></h1>

<p>
  What did you think of this release?
</p>

<p>
  Choose a score from 1 to 10.
  A score of 1 means you did not enjoy it.
  A score of 10 means you loved it.
</p>

<p>
  Writing additional thoughts is optional.
</p>

<% if @review.errors.any? %>
  <div class="review-errors">
    <h2>Please fix the following:</h2>

    <ul>
      <% @review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [ @record, @review ] do |form| %>
  <div class="review-form-section">
    <h2>Your Rating</h2>

    <div class="rating-labels">
      <span>Did not enjoy it</span>
      <span>Loved it</span>
    </div>

    <div class="rating-options">
      <% (1..10).each do |number| %>
        <div class="rating-choice">
          <%= form.radio_button :rating, number %>
          <%= form.label :rating,
                         number,
                         value: number,
                         class: "rating-button" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="review-form-section">
    <%= form.label :body, "Your Thoughts (Optional)" %>

    <%= form.text_area :body,
                       placeholder: "What stood out to you about this release?" %>
  </div>

  <%= form.submit "Save My Review" %>
<% end %>

<p>
  <%= link_to "Back to Release", record_path(@record) %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
