<h1>Add a New Artist</h1>

<p>
  Add an artist to the Crate Digger database.
  Once the artist exists, records can be connected to them.
</p>

<%= render ValidationErrorsComponent.new(
      resource: @artist
    ) %>
    
<%= form_with model: @artist do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :country %>
    <%= form.text_field :country %>
  </div>

  <%= form.submit "Create Artist" %>
<% end %>

<p>
  <%= link_to "Back to Artists", artists_path %>
</p>

<p>
  <%= link_to "Home", root_path %>
</p>
