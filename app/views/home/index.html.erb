<div class="home-page">
  <section class="home-content">
    <div class="home-logo">
      <div class="vinyl-record">
        <div class="vinyl-label"></div>
      </div>
    </div>

    <h1>Crate Digger</h1>

    <p class="home-tagline">
      Discover music, build your collection,
      and remember what you loved.
    </p>

    <% if current_user %>
      <h2>Welcome, <%= current_user.username %>!</h2>

      <p>
        Start by searching for a release you know.
        Crate Digger will help you find the correct music information.
      </p>

      <div class="home-actions">
        <%= link_to "Search for Music",
                    music_search_path,
                    class: "home-button" %>

        <%= link_to "View My Collection",
                    collection_entries_path,
                    class: "home-button" %>
      </div>

      <div class="home-logout">
        <%= button_to "Log Out",
                      logout_path,
                      method: :delete,
                      class: "home-button secondary-button" %>
      </div>
    <% else %>
      <h2>New Here?</h2>

      <p>
        You can browse Crate Digger without an account.
      </p>

      <p>
        Create an account to save music,
        add releases, and write reviews.
      </p>

      <div class="home-actions">
        <%= link_to "Create an Account",
                    signup_path,
                    class: "home-button" %>

        <%= link_to "Log In",
                    login_path,
                    class: "home-button secondary-button" %>
      </div>
    <% end %>

    <div class="home-browse">
      <h2>Browse Crate Digger</h2>

      <%= link_to "Browse Releases", records_path %>
      <%= link_to "Browse Artists", artists_path %>
      <%= link_to "Browse Genres", genres_path %>
    </div>

    <% if current_user %>
      <div class="home-manual">
        <h2>Can't Find Something?</h2>

        <p>
          If music search does not find the release you need,
          you can enter it manually.
        </p>

        <%= link_to "Enter a Release Manually",
                    new_record_path %>
      </div>
    <% end %>
  </section>

  <%= render AlbumWallComponent.new(
      records: @wall_records
    ) %>
</div>
