<h1>Sign Up</h1>

<p>
  Create an account to start building your personal record collection.
  You'll use this account to save records, purchase prices, and notes.
</p>

<%= render ValidationErrorsComponent.new(
      resource: @user
    ) %>

<%= form_with model: @user, url: signup_path do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm Password" %>
    <%= form.password_field :password_confirmation %>
  </div>

  <%= form.submit "Create Account" %>
<% end %>

<p>
  Already have an account?
  <%= link_to "Log In", login_path %>
</p>

<p>
  <%= link_to "Back to Home", root_path %>
</p>
